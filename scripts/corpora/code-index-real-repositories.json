{
  "schemaVersion": 1,
  "defaults": {
    "searchIterations": 7,
    "incrementalIterations": 7,
    "maxFileBytes": 512000
  },
  "corpora": [
    {
      "id": "relay-monorepo",
      "description": "The checked-out Relay Harness monorepo; always available to CI.",
      "ci": "required",
      "rootEnv": "RLH_CODE_INDEX_RELAY_ROOT",
      "rootCandidates": ["."],
      "markers": ["pnpm-workspace.yaml", "packages/index/code-index-local/src/provider.ts"],
      "incrementalProbePath": "code-index-external-corpus-probe.ts",
      "cases": [
        { "id": "refresh-scope", "query": "normalizeRefreshPaths workspace escape", "relevantPaths": ["packages/index/code-index-local/src/provider.ts"] },
        { "id": "context-inspector", "query": "ContextInspectorProjection omittedTraces", "relevantPaths": ["packages/context/context-inspector/src/types.ts"] },
        { "id": "mcp-catalog", "query": "McpCatalog listResourceTemplates", "relevantPaths": ["packages/mcp/mcp-catalog/src/index.ts"] },
        { "id": "product-mode", "query": "ProductModeSnapshot developer mode", "relevantPaths": ["packages/host/product-mode/src/types.ts"] },
        { "id": "embedding-generation", "query": "quantizerVersion chunkerVersion embedding generation", "relevantPaths": ["packages/index/code-index-local/src/embed/generation.ts"] }
      ],
      "thresholds": { "minRecallAt5": 0.6, "minMrr": 0.5, "maxFullIndexMs": 180000, "maxIncrementalP95Ms": 5000, "maxSearchP95Ms": 2000 }
    },
    {
      "id": "codecortex-rust",
      "description": "Optional authorized CodeCortex Rust checkout; source is never copied into Relay.",
      "ci": "optional",
      "rootEnv": "RLH_CODE_INDEX_CODECORTEX_ROOT",
      "rootCandidates": ["../codecortex-rust_副本", "codecortex-rust_副本"],
      "markers": ["Cargo.toml", "crates/cc-index/src/scanner.rs"],
      "incrementalProbePath": "code-index-external-corpus-probe.rs",
      "cases": [
        { "id": "scanner", "query": "Scanner scan_with_manifest IgnoreRules", "relevantPaths": ["crates/cc-index/src/scanner.rs"] },
        { "id": "memory-budget", "query": "MemoryBudget suggested_batch_size current_rss", "relevantPaths": ["crates/cc-index/src/memory_budget.rs"] },
        { "id": "hierarchy", "query": "generate_hierarchy_edges SemanticEdgeRecord", "relevantPaths": ["crates/cc-index/src/hierarchy.rs"] },
        { "id": "kubernetes", "query": "parse_k8s_manifest parse_kustomize", "relevantPaths": ["crates/cc-index/src/infra_k8s.rs"] },
        { "id": "build-plan", "query": "PreparedBuild WrittenBuild StagedPostprocess", "relevantPaths": ["crates/cc-index/src/build_plan.rs"] }
      ],
      "thresholds": { "minRecallAt5": 0.6, "minMrr": 0.5, "maxFullIndexMs": 180000, "maxIncrementalP95Ms": 5000, "maxSearchP95Ms": 2000 }
    },
    {
      "id": "auggie-recovered",
      "description": "Optional authorized Auggie recovered-source checkout; no recovered source is vendored.",
      "ci": "optional",
      "rootEnv": "RLH_CODE_INDEX_AUGGIE_ROOT",
      "rootCandidates": ["../auggie-packages", "auggie-packages"],
      "markers": ["README.md", "recovered/0.36.0/source-tree/spine/chunk-0046.mjs"],
      "incrementalProbePath": "code-index-external-corpus-probe.mjs",
      "cases": [
        { "id": "codebase-retrieval", "query": "codebase-retrieval PRIMARY tool", "relevantPaths": ["recovered/0.36.0/source-tree/spine/chunk-0046.mjs"] },
        { "id": "prompt-enhancer-request", "query": "Making prompt enhancer request conversationId chatHistoryLength", "relevantPaths": ["recovered/0.36.0/source-tree/spine/chunk-0019.mjs"] },
        { "id": "enhanced-prompt-tag", "query": "augment-enhanced-prompt enhanced prompt", "relevantPaths": ["recovered/0.36.0/source-tree/spine/chunk-0031.mjs"] },
        { "id": "cli-enhance", "query": "enhance-prompt Initial instruction print mode", "relevantPaths": ["recovered/0.36.0/source-tree/spine/chunk-0042.mjs"] }
      ],
      "thresholds": { "minRecallAt5": 0.5, "minMrr": 0.4, "maxFullIndexMs": 180000, "maxIncrementalP95Ms": 5000, "maxSearchP95Ms": 2000 }
    }
  ]
}
