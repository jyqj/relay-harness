{
  "name": "@relay-harness/rlh-tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyqj/relay-harness.git",
    "directory": "relay-harness/packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-shell": "workspace:^",
    "@relay-harness/rlh-shell-env": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-sandbox": "workspace:^",
    "@relay-harness/rlh-sandbox-policy": "workspace:^",
    "@relay-harness/rlh-system-prompt": "workspace:^",
    "@relay-harness/rlh-jobs": "workspace:^",
    "@relay-harness/rlh-tools": "workspace:^",
    "@relay-harness/rlh-user-approval": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  },
  "dependencies": {
    "@relay-harness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-agent-loop": "workspace:^",
    "@relay-harness/rlh-agent-loop-testkit": "workspace:^",
    "@relay-harness/rlh-shell": "workspace:^",
    "@relay-harness/rlh-shell-env": "workspace:^",
    "@relay-harness/rlh-bash-local": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-subprocess-local": "workspace:^",
    "@relay-harness/rlh-sandbox": "workspace:^",
    "@relay-harness/rlh-sandbox-policy": "workspace:^",
    "@relay-harness/rlh-session": "workspace:^",
    "@relay-harness/rlh-session-persistence-jsonl": "workspace:^",
    "@relay-harness/rlh-system-prompt": "workspace:^",
    "@relay-harness/rlh-jobs": "workspace:^",
    "@relay-harness/rlh-jobs-local": "workspace:^",
    "@relay-harness/rlh-tool-jobs": "workspace:^",
    "@relay-harness/rlh-tools": "workspace:^",
    "@relay-harness/rlh-user-approval": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  }
}
