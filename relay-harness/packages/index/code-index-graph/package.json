{
  "name": "@relay-harness/rlh-code-index-graph",
  "description": "Symbol-resolution layer for the Relay Harness code-index capability: an in-memory symbol catalog and the nine-step resolution ladder that binds call edges and symbol refs to target symbols",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyqj/relay-harness.git",
    "directory": "relay-harness/packages/index/code-index-graph"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@relay-harness/cordis": "workspace:^",
    "@relay-harness/rlh-code-index": "workspace:^",
    "@relay-harness/rlh-code-index-parser": "workspace:^",
    "@relay-harness/rlh-code-index-search": "workspace:^",
    "@relay-harness/rlh-code-index-sqlite": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@relay-harness/cordis": "workspace:^",
    "@relay-harness/rlh-code-index": "workspace:^",
    "@relay-harness/rlh-code-index-parser": "workspace:^",
    "@relay-harness/rlh-code-index-search": "workspace:^",
    "@relay-harness/rlh-code-index-sqlite": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^"
  }
}
