{
  "name": "@relay-harness/rlh-agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the Relay Harness",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyqj/relay-harness.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@relay-harness/cordis-plugin-include": "workspace:^",
    "@relay-harness/cordis-plugin-loader": "workspace:^",
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-atomic-write": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-home-paths": "workspace:^",
    "@relay-harness/rlh-scope": "workspace:^",
    "@relay-harness/rlh-session": "workspace:^",
    "@relay-harness/rlh-settings": "workspace:^",
    "@relay-harness/rlh-system-prompt": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@relay-harness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@relay-harness/cordis-plugin-include": "workspace:^",
    "@relay-harness/cordis-plugin-loader": "workspace:^",
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-agent-loop": "workspace:^",
    "@relay-harness/rlh-atomic-write": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-home-paths": "workspace:^",
    "@relay-harness/rlh-scope": "workspace:^",
    "@relay-harness/rlh-session": "workspace:^",
    "@relay-harness/rlh-settings": "workspace:^",
    "@relay-harness/rlh-settings-file": "workspace:^",
    "@relay-harness/rlh-system-prompt": "workspace:^",
    "@relay-harness/rlh-tools": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  }
}
