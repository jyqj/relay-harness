{
  "name": "@relay-harness/rlh-hooks-claude-code",
  "description": "Bridge plugin: run a Claude Code hooks.json / settings hook config on the Relay Harness interception seams",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyqj/relay-harness.git",
    "directory": "packages/hooks/hooks-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@relay-harness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-hook-protocol": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-session": "workspace:^",
    "@relay-harness/rlh-session-persistence": "workspace:^",
    "@relay-harness/rlh-subagent": "workspace:^",
    "@relay-harness/rlh-tools": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-agent-loop": "workspace:^",
    "@relay-harness/rlh-agent-loop-testkit": "workspace:^",
    "@relay-harness/rlh-shell": "workspace:^",
    "@relay-harness/rlh-bash-local": "workspace:^",
    "@relay-harness/rlh-subprocess-local": "workspace:^",
    "@relay-harness/rlh-hook-protocol": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-session": "workspace:^",
    "@relay-harness/rlh-session-persistence": "workspace:^",
    "@relay-harness/rlh-session-persistence-jsonl": "workspace:^",
    "@relay-harness/rlh-subagent": "workspace:^",
    "@relay-harness/rlh-tools": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  }
}
