{
  "name": "@relay-harness/rlh-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Relay Harness SDK clients",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyqj/relay-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@relay-harness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-llm-deepseek": "workspace:^",
    "@relay-harness/rlh-scope": "workspace:^",
    "@relay-harness/rlh-sdk-protocol": "workspace:^",
    "@relay-harness/rlh-session": "workspace:^",
    "@relay-harness/rlh-subagent": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@relay-harness/cordis-plugin-loader": "workspace:^",
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-agent-spine-demo": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-llm-deepseek": "workspace:^",
    "@relay-harness/rlh-scope": "workspace:^",
    "@relay-harness/rlh-sdk-protocol": "workspace:^",
    "@relay-harness/rlh-session": "workspace:^",
    "@relay-harness/rlh-session-persistence-jsonl": "workspace:^",
    "@relay-harness/rlh-subagent": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  }
}
