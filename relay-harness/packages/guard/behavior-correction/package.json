{
  "name": "@relay-harness/rlh-behavior-correction",
  "description": "Behavior-correction guard: steers one bounded corrective message when a turn closes on an empty answer, an unexecuted code block, or an unverified completion claim",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyqj/relay-harness.git",
    "directory": "relay-harness/packages/guard/behavior-correction"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@relay-harness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-agent-loop": "workspace:^",
    "@relay-harness/rlh-agent-loop-testkit": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-session": "workspace:^",
    "@relay-harness/rlh-tools": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  }
}
