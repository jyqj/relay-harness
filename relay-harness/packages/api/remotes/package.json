{
  "name": "@relay-harness/rlh-api-remotes",
  "description": "Remote BFF assembly and Host Agent/Session lookup policy",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyqj/relay-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "rlh": {
    "client": {
      "inject": [
        "@relay-harness/rlh-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@relay-harness/rlh-typert-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-agent-presets": "workspace:^",
    "@relay-harness/rlh-api-gateway": "workspace:^",
    "@relay-harness/rlh-commands": "workspace:^",
    "@relay-harness/rlh-cordis-host-runner": "workspace:^",
    "@relay-harness/rlh-context-engine": "workspace:^",
    "@relay-harness/rlh-credentials": "workspace:^",
    "@relay-harness/rlh-file-reference": "workspace:^",
    "@relay-harness/rlh-goal": "workspace:^",
    "@relay-harness/rlh-host-plugin-inventory": "workspace:^",
    "@relay-harness/rlh-host-mcp-servers": "workspace:^",
    "@relay-harness/rlh-host-skill-inventory": "workspace:^",
    "@relay-harness/rlh-host-memory-center": "workspace:^",
    "@relay-harness/rlh-host-code-index-center": "workspace:^",
    "@relay-harness/rlh-host-product-mode": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-issue-orchestration": "workspace:^",
    "@relay-harness/rlh-issue-orchestrator": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-message-feedback": "workspace:^",
    "@relay-harness/rlh-prompt-enhancement": "workspace:^",
    "@relay-harness/rlh-session": "workspace:^",
    "@relay-harness/rlh-session-persistence": "workspace:^",
    "@relay-harness/rlh-session-reference": "workspace:^",
    "@relay-harness/rlh-settings": "workspace:^",
    "@relay-harness/rlh-typert-registry": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  },
  "devDependencies": {
