{
  "name": "@relay-harness/rlh-file-reference-local",
  "description": "Local-filesystem ctx.fileReferences provider with bounded fuzzy indexes",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyqj/relay-harness.git",
    "directory": "relay-harness/packages/context/file-reference-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./search": {
      "types": "./lib/types/search.d.ts",
      "default": "./lib/types/search.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@relay-harness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@relay-harness/cordis": "workspace:^",
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-context-engine": "workspace:^",
    "@relay-harness/rlh-file-reference": "workspace:^",
    "@relay-harness/rlh-fs": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-system-prompt": "workspace:^",
    "@relay-harness/rlh-tools": "workspace:^"
  },
  "devDependencies": {
    "@relay-harness/cordis": "workspace:^",
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-context-engine": "workspace:^",
    "@relay-harness/rlh-file-reference": "workspace:^",
    "@relay-harness/rlh-fs": "workspace:^",
    "@relay-harness/rlh-fs-local": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-system-prompt": "workspace:^",
    "@relay-harness/rlh-tools": "workspace:^"
  }
}
