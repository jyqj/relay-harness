{
  "name": "@relay-harness/rlh-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyqj/relay-harness.git",
    "directory": "relay-harness/packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@relay-harness/rlh-attachment": "workspace:^",
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-agent-default-model": "workspace:^",
    "@relay-harness/rlh-api-remotes": "workspace:^",
    "@relay-harness/rlh-brand": "workspace:^",
    "@relay-harness/rlh-commands": "workspace:^",
    "@relay-harness/rlh-credentials": "workspace:^",
    "@relay-harness/rlh-goal": "workspace:^",
    "@relay-harness/rlh-home-paths": "workspace:^",
    "@relay-harness/rlh-host-directory-picker": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-native-command": "workspace:^",
    "@relay-harness/rlh-session": "workspace:^",
    "@relay-harness/rlh-session-persistence": "workspace:^",
    "@relay-harness/rlh-session-projection": "workspace:^",
    "@relay-harness/rlh-session-projection-cache": "workspace:^",
    "@relay-harness/rlh-session-query": "workspace:^",
    "@relay-harness/rlh-session-title": "workspace:^",
    "@relay-harness/rlh-settings": "workspace:^",
    "@relay-harness/rlh-skill": "workspace:^",
    "@relay-harness/rlh-subagent": "workspace:^",
    "@relay-harness/rlh-jobs": "workspace:^",
    "@relay-harness/rlh-tools": "workspace:^",
    "@relay-harness/rlh-user-approval": "workspace:^",
    "@relay-harness/rlh-user-questions": "workspace:^",
    "@relay-harness/rlh-workspace": "workspace:^",
    "@relay-harness/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@relay-harness/cordis": "workspace:^",
    "@relay-harness/rlh-agent-presets": "workspace:^",
    "@relay-harness/rlh-cordis-host-runner": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-issue-orchestration": "workspace:^"
  },
  "devDependencies": {
    "@relay-harness/cordis": "workspace:^",
    "@relay-harness/rlh-agent-presets": "workspace:^",
    "@relay-harness/rlh-cordis-host-runner": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-issue-orchestration": "workspace:^",
    "@relay-harness/rlh-storage": "workspace:^",
    "@relay-harness/rlh-storage-domain": "workspace:^",
    "@relay-harness/rlh-typert-protocol": "workspace:^",
    "@relay-harness/rlh-typert-registry": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  }
}
