{
  "name": "@relay-harness/rlh-host-work-results",
  "description": "Session-log user acceptance and paginated cross-session deliverable queries",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
