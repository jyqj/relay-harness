    "@relay-harness/rlh-jobs": "workspace:^",
    "@relay-harness/rlh-host-apiproxy": "workspace:^",
    "@relay-harness/rlh-brand": "workspace:^",
    "@relay-harness/rlh-app-boot": "workspace:^",
