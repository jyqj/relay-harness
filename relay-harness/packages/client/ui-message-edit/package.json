{
  "name": "@relay-harness/rlh-client-ui-message-edit",
  "description": "Inline edit-and-resend for the latest user message",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyqj/relay-harness.git",
    "directory": "relay-harness/packages/client/ui-message-edit"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "rlh": {
    "client": {
      "inject": [
        "@relay-harness/rlh-client-runtime",
        "@relay-harness/rlh-client-locale",
        "@relay-harness/rlh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@relay-harness/rlh-client-locale": "workspace:^",
    "@relay-harness/rlh-client-runtime": "workspace:^",
    "@relay-harness/rlh-client-ui-conversation": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@relay-harness/rlh-client-locale": "workspace:^",
    "@relay-harness/rlh-client-runtime": "workspace:^",
    "@relay-harness/rlh-client-test-runtime": "workspace:^",
    "@relay-harness/rlh-client-ui-conversation": "workspace:^",
    "@relay-harness/rlh-client-ui-primitives": "workspace:^",
    "@relay-harness/rlh-client-ui-slots": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/cordis": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^19.2.8"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
