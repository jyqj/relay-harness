{
  "name": "@relay-harness/rlh-client-ui-user-terminal",
  "description": "Shared user terminal: bottom drawer and right-panel surface over one PTY session table",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyqj/relay-harness.git",
    "directory": "packages/client/ui-user-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "rlh": {
    "client": {
      "inject": [
        "@relay-harness/rlh-client-runtime",
        "@relay-harness/rlh-client-ui-layout",
        "@relay-harness/rlh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown && node scripts/copy-ghostty-assets.mjs",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@relay-harness/cordis": "workspace:^",
    "@relay-harness/rlh-client-locale": "workspace:^",
    "@relay-harness/rlh-client-runtime": "workspace:^",
    "@relay-harness/rlh-client-ui-layout": "workspace:^",
    "@relay-harness/rlh-client-ui-primitives": "workspace:^",
    "@relay-harness/rlh-client-ui-slots": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "react": "^18.2.0",
    "@relay-harness/rlh-client-ui-surfaces": "workspace:^"
  },
  "devDependencies": {
    "@relay-harness/cordis": "workspace:^",
    "@relay-harness/rlh-client-locale": "workspace:^",
    "@relay-harness/rlh-client-runtime": "workspace:^",
    "@relay-harness/rlh-client-test-runtime": "workspace:^",
    "@relay-harness/rlh-client-ui-layout": "workspace:^",
    "@relay-harness/rlh-client-ui-primitives": "workspace:^",
    "@relay-harness/rlh-client-ui-slots": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@relay-harness/rlh-client-ui-surfaces": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/assets/**",
    "lib/types/**/*.d.ts"
  ]
}
