    "@relay-harness/rlh-client-runtime": "workspace:^",
    "@relay-harness/rlh-client-ui-settings": "workspace:^",
    "@relay-harness/rlh-client-ui-input-trigger": "workspace:^",
    "@relay-harness/rlh-commands": "workspace:^",
    "@relay-harness/rlh-compaction": "workspace:^",
