{
  "name": "@relay-harness/rlh-client-runtime",
  "description": "Client core services: SlotRegistry, SessionRuntime (scope tree + object layer)",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyqj/relay-harness.git",
    "directory": "relay-harness/packages/client/runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "rlh": {
    "client": {
      "inject": [
        "@relay-harness/rlh-client-connection",
        "@relay-harness/rlh-typert-registry",
        "@relay-harness/rlh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "immer": "^10.1.1",
    "zustand": "~4.4.7"
  },
  "peerDependencies": {
    "@relay-harness/cordis": "workspace:^",
    "@relay-harness/rlh-api-remotes": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-typert-protocol": "workspace:^",
    "@relay-harness/rlh-typert-registry": "workspace:^",
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-attachment": "workspace:^",
    "@relay-harness/rlh-client-connection": "workspace:^",
    "@relay-harness/rlh-commands": "workspace:^",
    "@relay-harness/rlh-host-apiproxy": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-llm-retry": "workspace:^",
    "@relay-harness/rlh-session": "workspace:^",
    "@relay-harness/rlh-session-projection": "workspace:^",
    "@relay-harness/rlh-session-title": "workspace:^",
    "@relay-harness/rlh-tools": "workspace:^"
  },
  "devDependencies": {
    "@relay-harness/cordis": "workspace:^",
    "@relay-harness/rlh-api-remotes": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-timeout": "workspace:^",
    "@relay-harness/rlh-typert-protocol": "workspace:^",
    "@relay-harness/rlh-typert-registry": "workspace:^",
    "@types/react": "~18.3.1",
    "@relay-harness/rlh-client-ui-slots": "workspace:^",
    "react": "^18.2.0",
    "@relay-harness/rlh-agent": "workspace:^",
    "@relay-harness/rlh-attachment": "workspace:^",
    "@relay-harness/rlh-client-connection": "workspace:^",
    "@relay-harness/rlh-commands": "workspace:^",
    "@relay-harness/rlh-host-apiproxy": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-llm-retry": "workspace:^",
    "@relay-harness/rlh-session": "workspace:^",
    "@relay-harness/rlh-session-projection": "workspace:^",
    "@relay-harness/rlh-session-title": "workspace:^",
    "@relay-harness/rlh-tools": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
