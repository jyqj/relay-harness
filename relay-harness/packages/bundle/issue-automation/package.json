{
  "name": "@relay-harness/rlh-issue-automation",
  "description": "Opt-in tracker-driven issue automation bundle over the Web profile",
  "version": "0.1.0-rc.8",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/jyqj/relay-harness.git", "directory": "relay-harness/packages/bundle/issue-automation" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "cordis.patch.yml", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "rlh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@relay-harness/rlh-client-ui-issue-orchestration": "workspace:^",
    "@relay-harness/rlh-issue-orchestrator": "workspace:^",
    "@relay-harness/rlh-issue-runner-agent": "workspace:^",
    "@relay-harness/rlh-issue-workflow-file": "workspace:^",
    "@relay-harness/rlh-issue-workspace-local": "workspace:^",
    "@relay-harness/rlh-tracker": "workspace:^",
    "@relay-harness/rlh-tracker-linear": "workspace:^"
  },
  "peerDependencies": {
    "@relay-harness/rlh-agent-default-model": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@relay-harness/rlh-agent-default-model": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  }
}
