{
  "name": "@relay-harness/rlh-web-app",
  "description": "The rlh browser-surface bundle: the web patch layer over rlh-base plus the runtime glue plugin (frontend dist serving, web-surface prompt, bash runtime variables, URL line)",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
