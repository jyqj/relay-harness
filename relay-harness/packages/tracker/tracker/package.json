{
  "name": "@relay-harness/rlh-tracker",
  "description": "Provider-neutral issue-tracker registry and run-scoped native-tool binding for Relay Harness",
  "version": "0.1.0-rc.8",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyqj/relay-harness.git",
    "directory": "packages/tracker/tracker"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types/types.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/types/**/*.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@relay-harness/rlh-brand": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-session": "workspace:^",
    "@relay-harness/rlh-tools": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@relay-harness/rlh-brand": "workspace:^",
    "@relay-harness/rlh-invariants": "workspace:^",
    "@relay-harness/rlh-llm": "workspace:^",
    "@relay-harness/rlh-session": "workspace:^",
    "@relay-harness/rlh-tools": "workspace:^",
    "@relay-harness/cordis": "workspace:^"
  }
}
