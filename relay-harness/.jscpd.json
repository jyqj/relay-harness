{
  "minTokens": 60,
  "minLines": 6,
  "mode": "mild",
  "threshold": 1,
  "format": ["typescript", "tsx", "javascript"],
  "pattern": "**/*.{ts,tsx,js,jsx}",
  "ignore": [
    "**/tests/**",
    "**/tsdown.config.ts",
    "**/ui-user-terminal/src/client/terminal/ghostty/**",
    "apps/desktop/vendor/**"
  ],
  "ignorePattern": [
    "(?s)/\\* jscpd:ignore-start \\*/.*?/\\* jscpd:ignore-end \\*/"
  ],
  "reporters": ["console"],
  "noColors": true,
  "noTips": true
}
