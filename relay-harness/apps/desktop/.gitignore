# A vendored plugin's compiled half has no upstream to refetch it from, so it is
# tracked despite the repository-wide build-output ignores. Its dependencies do
# have one and are installed by `pnpm run vendor:sync`, so they stay ignored.
# vendor/README.md owns the rule; vendor/vendor-plugins.test.js gates it.
node_modules/
dist/
!vendor/rlhmarket/lib/
!vendor/rlhmarket/lib/**
!vendor/rlhbot/lib/
!vendor/rlhbot/lib/**
dist-release/
out/
/release/
*.log
.DS_Store
Thumbs.db
.env
**/__pycache__/
*.pyc
.idea/
.vscode/
*.iml
.pack-v2/
.pack-tmp*/
.pack-v*/
/release*/
/resources/
.worktrees/
mobile/.expo/
mobile/dist/

# Local agent/QA artifacts
gui-test-screenshots/
.cursor/
.zcode/
plugins/
.final-gates/
